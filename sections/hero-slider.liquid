{% liquid
  assign section_id = section.id
  assign autoplay = section.settings.autoplay
  assign autoplay_speed = section.settings.autoplay_speed | times: 1000
%}

<div
  id="HeroSlider-{{ section_id }}"
  class="hero-slider"
  data-autoplay="{{ autoplay }}"
  data-autoplay-speed="{{ autoplay_speed }}"
>
  <div class="hero-slider__container">
    <div class="hero-slider__slides" data-slides>
      {% for block in section.blocks %}
        <div
          class="hero-slider__slide{% if forloop.first %} is-active{% endif %}"
          data-slide-index="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          <div class="hero-slider__media">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1920
                | image_tag:
                  loading: 'lazy',
                  class: 'hero-slider__image',
                  widths: '750, 1080, 1296, 1512, 1728, 1920',
                  sizes: '100vw'
              }}
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-slider__image' }}
            {% endif %}
            <div class="hero-slider__overlay"></div>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="hero-slider__content-wrapper">
      {% for block in section.blocks %}
        <div
          class="hero-slider__content{% if forloop.first %} is-active{% endif %}"
          data-content-index="{{ forloop.index0 }}"
        >
          {% if block.settings.subtitle != blank %}
            <span class="hero-slider__subtitle">{{ block.settings.subtitle }}</span>
          {% endif %}

          {% if block.settings.heading != blank %}
            <h2 class="hero-slider__heading">{{ block.settings.heading }}</h2>
          {% endif %}

          {% if block.settings.description != blank %}
            <p class="hero-slider__description">{{ block.settings.description }}</p>
          {% endif %}

          {% if block.settings.button_label != blank %}
            <a
              href="{{ block.settings.button_link }}"
              class="hero-slider__button button"
            >
              <span class="hero-slider__button-text">{{ block.settings.button_label }}</span>
              <span class="hero-slider__button-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                  <path d="M4 10H16M16 10L11 5M16 10L11 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 %}
      <div class="hero-slider__navigation">
        <div class="hero-slider__progress">
          <div class="hero-slider__progress-bar" data-progress></div>
        </div>
        <div class="hero-slider__arrows">
          <button
            type="button"
            class="hero-slider__arrow hero-slider__arrow--prev"
            data-prev
            aria-label="{{ 'accessibility.previous' | t }}"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button
            type="button"
            class="hero-slider__arrow hero-slider__arrow--next"
            data-next
            aria-label="{{ 'accessibility.next' | t }}"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
        <div class="hero-slider__counter">
          <span data-current>1</span>
          <span class="hero-slider__counter-divider">/</span>
          <span data-total>{{ section.blocks.size }}</span>
        </div>
      </div>

      <div class="hero-slider__dots">
        {% for block in section.blocks %}
          <button
            type="button"
            class="hero-slider__dot{% if forloop.first %} is-active{% endif %}"
            data-dot="{{ forloop.index0 }}"
            aria-label="Slide {{ forloop.index }}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

<script src="{{ 'hero-slider.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% stylesheet %}
  .hero-slider {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: rgb(var(--color-background));
  }

  .hero-slider__container {
    position: relative;
    min-height: 70svh;
    display: flex;
    flex-direction: column;
  }

  @media screen and (min-width: 750px) {
    .hero-slider__container {
      min-height: 85svh;
    }
  }

  .hero-slider__slides {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-slider__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hero-slider__slide.is-active {
    opacity: 1;
    z-index: 2;
  }

  .hero-slider__media {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .hero-slider__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-slider__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.1) 0%,
      rgb(0 0 0 / 0.3) 50%,
      rgb(0 0 0 / 0.6) 100%
    );
    pointer-events: none;
  }

  .hero-slider__content-wrapper {
    position: relative;
    z-index: 3;
    flex: 1;
    display: flex;
    align-items: center;
    padding: var(--padding-xl) var(--page-margin);
    padding-block-start: calc(var(--header-group-height, 0px) + var(--padding-xl));
  }

  @media screen and (min-width: 750px) {
    .hero-slider__content-wrapper {
      padding-inline: max(var(--page-margin), 5vw);
    }
  }

  .hero-slider__content {
    position: absolute;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease, transform 0.6s ease;
    pointer-events: none;
    max-width: 600px;
  }

  @media screen and (max-width: 749px) {
    .hero-slider__content {
      position: relative;
      width: 100%;
      margin-top: auto;
      margin-bottom: 140px;
      padding: var(--padding-lg);
      background: rgb(var(--color-background) / 0.95);
      backdrop-filter: blur(10px);
      border-radius: var(--style-border-radius-lg);
      box-shadow: 0 -10px 40px rgb(0 0 0 / 0.1);
    }
  }

  .hero-slider__content.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .hero-slider__subtitle {
    display: inline-block;
    font-size: var(--font-size--xs);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.7);
    margin-block-end: var(--margin-sm);
  }

  @media screen and (min-width: 750px) {
    .hero-slider__subtitle {
      color: rgb(255 255 255 / 0.85);
    }
  }

  .hero-slider__heading {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-block-end: var(--margin-md);
  }

  @media screen and (min-width: 750px) {
    .hero-slider__heading {
      color: rgb(255 255 255);
      text-shadow: 0 2px 20px rgb(0 0 0 / 0.3);
    }
  }

  .hero-slider__description {
    font-size: var(--font-size--md);
    line-height: 1.6;
    color: rgb(var(--color-foreground-rgb) / 0.8);
    margin-block-end: var(--margin-lg);
    max-width: 480px;
  }

  @media screen and (min-width: 750px) {
    .hero-slider__description {
      color: rgb(255 255 255 / 0.9);
    }
  }

  .hero-slider__button {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-sm);
    padding: var(--padding-lg) var(--padding-2xl);
    font-size: var(--font-size--md);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--style-border-radius-buttons-primary);
    transition: transform 0.3s var(--ease-out-cubic), box-shadow 0.3s ease;
    cursor: pointer;
  }

  .hero-slider__button:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgb(var(--color-primary-button-background) / 0.3);
  }

  .hero-slider__button-icon {
    display: flex;
    transition: transform 0.3s ease;
  }

  .hero-slider__button:hover .hero-slider__button-icon {
    transform: translateX(4px);
  }

  .hero-slider__navigation {
    position: absolute;
    bottom: var(--padding-xl);
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    gap: var(--gap-lg);
    padding: var(--padding-sm) var(--padding-lg);
    background: rgb(var(--color-background) / 0.9);
    backdrop-filter: blur(10px);
    border-radius: var(--style-border-radius-pills);
    box-shadow: 0 4px 20px rgb(0 0 0 / 0.15);
  }

  @media screen and (max-width: 749px) {
    .hero-slider__navigation {
      position: fixed;
      bottom: var(--padding-lg);
      left: var(--page-margin);
      right: var(--page-margin);
      transform: none;
    }
  }

  .hero-slider__progress {
    width: 60px;
    height: 3px;
    background: rgb(var(--color-foreground-rgb) / 0.1);
    border-radius: 2px;
    overflow: hidden;
  }

  .hero-slider__progress-bar {
    height: 100%;
    width: 0%;
    background: var(--color-foreground);
    border-radius: 2px;
    transition: width 0.3s ease;
  }

  .hero-slider__arrows {
    display: flex;
    gap: var(--gap-xs);
  }

  .hero-slider__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: transparent;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.15);
    border-radius: 50%;
    color: var(--color-foreground);
    cursor: pointer;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .hero-slider__arrow:hover {
    background: rgb(var(--color-foreground-rgb) / 0.05);
    border-color: rgb(var(--color-foreground-rgb) / 0.3);
  }

  .hero-slider__arrow svg {
    width: 18px;
    height: 18px;
  }

  .hero-slider__counter {
    font-size: var(--font-size--sm);
    font-weight: 600;
    color: rgb(var(--color-foreground-rgb) / 0.6);
    min-width: 50px;
    text-align: center;
  }

  .hero-slider__counter-divider {
    margin-inline: var(--gap-2xs);
    opacity: 0.4;
  }

  .hero-slider__dots {
    position: absolute;
    bottom: var(--padding-xl);
    right: max(var(--page-margin), 5vw);
    z-index: 10;
    display: flex;
    gap: var(--gap-xs);
  }

  @media screen and (max-width: 749px) {
    .hero-slider__dots {
      display: none;
    }
  }

  .hero-slider__dot {
    width: 12px;
    height: 12px;
    padding: 0;
    background: rgb(255 255 255 / 0.3);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.3s ease;
  }

  .hero-slider__dot:hover {
    background: rgb(255 255 255 / 0.5);
  }

  .hero-slider__dot.is-active {
    background: rgb(255 255 255);
    transform: scale(1.2);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero Slider",
  "tag": "section",
  "class": "hero-slider-section",
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "New Collection"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Discover Our Latest Styles"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Explore our curated collection of premium products designed for modern living."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Change slides every",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "Hero Slider",
      "category": "Banners",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "subtitle": "New Arrivals",
            "heading": "Spring Collection 2026",
            "description": "Discover the latest trends in fashion and style.",
            "button_label": "Shop Collection"
          }
        },
        {
          "type": "slide",
          "settings": {
            "subtitle": "Best Sellers",
            "heading": "Most Popular Items",
            "description": "Explore our customers' favorite products.",
            "button_label": "View Best Sellers"
          }
        }
      ]
    }
  ]
}
{% endschema %}
